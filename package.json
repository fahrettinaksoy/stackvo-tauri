{
  "name": "stackvo-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Native desktop app for StackVo — Docker-based local development environment manager",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "app": "tauri dev",
    "app:build": "tauri build",
    "dev:kill": "lsof -ti tcp:1420 | xargs kill 2>/dev/null || true",
    "test": "npm run test:js && cargo test --manifest-path src-tauri/Cargo.toml",
    "diagnose": "cargo run --manifest-path src-tauri/Cargo.toml --example diagnose",
    "contracts:check": "node tools/validate-contracts.mjs --root ../stackvo",
    "test:js": "vitest run",
    "test:js:watch": "vitest",
    "test:js:coverage": "vitest run --coverage",
    "test:rs:coverage": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --summary-only && cargo llvm-cov report --manifest-path src-tauri/Cargo.toml --json --summary-only > rust-coverage.json && node tools/check-coverage.mjs --rust",
    "coverage:floors": "node tools/check-coverage.mjs",
    "bundle:budget": "node tools/check-bundle.mjs",
    "notice": "node tools/generate-notice.mjs",
    "notice:check": "node tools/generate-notice.mjs --check",
    "lint": "eslint . && prettier --check \"src/**/*.{js,vue}\"",
    "lint:fix": "eslint . --fix && prettier --write \"src/**/*.{js,vue}\"",
    "audit": "cargo deny --manifest-path src-tauri/Cargo.toml check && npm audit --omit=dev --audit-level=moderate"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.4.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.40",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.6.4",
    "vuetify": "^3.12.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.11",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "vite": "^7.3.6",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^3.2.7",
    "vitest-axe": "^0.1.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
