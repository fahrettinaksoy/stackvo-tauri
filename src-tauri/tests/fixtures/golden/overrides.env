# The settings the golden render is frozen against.
#
# Only overrides — everything else comes from `config::EMBEDDED`, which is what
# a real workspace does too. Keeping this file to the minimum means a change to
# a shipped default shows up in the golden diff instead of being masked here.
#
# The four machine-specific values are pinned deliberately. `template::variables`
# fills them from the process (`getuid()`, the workspace path) when nothing else
# has, and a golden file carrying one developer's uid or home directory would
# fail on every other machine. `golden_render.rs` asserts the pinned values are
# what actually came through.
STACKVO_ROOT=/stackvo
HOST_STACKVO_ROOT=/stackvo
HOST_UID=1000
HOST_GID=1000

# Every dynamic service on. A disabled one contributes nothing to
# docker-compose.dynamic.yml, so the frozen file would simply not cover it —
# and the volumes section is harvested from all templates regardless of whether
# the service is switched on, which is a rule only a full render exercises.
SERVICE_MYSQL_ENABLE=true
SERVICE_MARIADB_ENABLE=true
SERVICE_POSTGRES_ENABLE=true
SERVICE_MONGO_ENABLE=true
SERVICE_CASSANDRA_ENABLE=true
SERVICE_REDIS_ENABLE=true
SERVICE_MEMCACHED_ENABLE=true
SERVICE_RABBITMQ_ENABLE=true
SERVICE_KAFKA_ENABLE=true
SERVICE_ELASTICSEARCH_ENABLE=true
SERVICE_KIBANA_ENABLE=true
SERVICE_GRAFANA_ENABLE=true
SERVICE_MAILHOG_ENABLE=true
SERVICE_MAILPIT_ENABLE=true
SERVICE_PHPMYADMIN_ENABLE=true
SERVICE_ADMINER_ENABLE=true
SERVICE_PGADMIN_ENABLE=true
SERVICE_KAFBAT_ENABLE=true
SERVICE_MONGO_EXPRESS_ENABLE=true
SERVICE_PHPCACHEADMIN_ENABLE=true
SERVICE_BLACKFIRE_ENABLE=true
