{
  "name": "probe-nginx",
  "domain": "probe-nginx.loc",
  "runtime": "php",
  "server": "nginx",
  "document_root": "public",
  "php": {
    "version": "8.4",
    "extensions": [
      "mbstring",
      "pdo",
      "pdo_mysql",
      "curl",
      "zip",
      "gd",
      "redis",
      "xdebug",
      "intl",
      "bcmath"
    ]
  }
}
