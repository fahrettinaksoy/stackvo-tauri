    "tag": "5.2"
  },
  "capabilities": ["admin-ui"],
  "instancing": { "multiple": false, "identity": "version" },
  "ports": [
    { "name": "main", "container": 80, "preferred": 8081, "protocol": "tcp", "legacyKey": "SERVICE_PHPMYADMIN_HOST_PORT", "primary": false }
